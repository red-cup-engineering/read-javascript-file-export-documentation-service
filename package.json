{
  "name": "@red-cup-engineering/read-javascript-file-export-documentation-service",
  "version": "0.2.0",
  "description": "Reads source-bound JSDoc for exported JavaScript functions and named foreign reexports without executing the source.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/read-javascript-file-export-documentation-service.git"
  },
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": {
    ".": "./scripts/read-javascript-file-export-documentation.mjs",
    "./description": "./scripts/javascript-export-description.mjs"
  },
  "bin": {
    "read-javascript-file-export-documentation": "scripts/read-javascript-file-export-documentation.mjs"
  },
  "files": [
    "scripts",
    "package.json",
    "docs/API.md",
    "examples/quickstart.test.mjs"
  ],
  "dependencies": {
    "@red-cup-engineering/javascript-parser-service": "^0.1.1",
    "@red-cup-engineering/computer-content-engineering-services-section": "0.1.0",
    "@red-cup-engineering/computer-file-engineering-services-section": "0.4.0",
    "@red-cup-engineering/jsonl-engineering-services-section": "0.1.0",
    "@red-cup-engineering/javascript-node-engineering-services-section": "0.3.2"
  },
  "scripts": {
    "check": "node --check scripts/read-javascript-file-export-documentation.mjs && node --check scripts/javascript-export-description.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts",
    "test:consumer": "node --test examples/quickstart.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  },
  "packageManager": "pnpm@11.19.0"
}
